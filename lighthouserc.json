{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/serve.mjs 4174",
      "startServerReadyPattern": "Serving out/",
      "url": ["http://localhost:4174/de/", "http://localhost:4174/fr/", "http://localhost:4174/de/privacy/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
