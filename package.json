{
  "name": "smiit-analytics-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Product website of smiit Analytics – reporting for bexio, a product of smiit GmbH.",
  "scripts": {
    "predev": "node scripts/build-media.mjs --variants",
    "dev": "next dev",
    "prebuild": "node scripts/build-media.mjs --variants",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/build-media.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.577.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.30",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
